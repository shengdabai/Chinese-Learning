# Backend configuration for Chinese-Learning.
# Copy this file to backend/.env (or export these in your environment).

# Required: your OpenAI API key.
OPENAI_API_KEY=YOUR_KEY_HERE

# Optional: OpenAI model name (defaults to gpt-3.5-turbo).
OPENAI_MODEL=gpt-3.5-turbo

# Optional: MongoDB connection (defaults to mongodb://localhost:27017).
# The backend falls back to in-memory storage if MongoDB is unavailable.
MONGO_URL=mongodb://localhost:27017
DB_NAME=test_database

# Optional: comma-separated list of allowed CORS origins.
# Production deployments should set this to the real frontend domain(s).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001,http://127.0.0.1:3000

# Frontend: point the React app at your backend (defaults to http://localhost:8001).
REACT_APP_BACKEND_URL=http://localhost:8001
